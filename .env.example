# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://miihcjvmfskbsckzodvo.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_secret

# Source project: npm run hash-passcode -- "your passcode"
# Production ZIP: run SETUP-WINDOWS.cmd (recommended)
PASSCODE_HASH=\$2b\$12\$replace_with_a_bcrypt_hash
# SETUP-WINDOWS.cmd generates this automatically.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TIMEOUT_MINUTES=480
